#!/usr/bin/env bash
root="${CLAUDE_PROJECT_DIR:-$PWD}"
dir="${1:-docs/map}"
cd "$root" || exit 1
if [ ! -d "$dir" ]; then
  echo "SKIP no $dir"
  exit 0
fi

checked=0
broken=0
broke() { echo "BROKEN $1"; broken=$((broken + 1)); }

is_path() {
  case $1 in
    *[[:space:]]* | *['<>*{}$:|()=,']* | /* | ~* | .ult/* | -*) return 1 ;;
    */*) return 0 ;;
  esac
  return 1
}

while IFS= read -r -d '' f; do
  n=0
  fence=0
  while IFS= read -r line || [ -n "$line" ]; do
    n=$((n + 1))
    case $line in '```'*) fence=$((1 - fence)); continue ;; esac
    [ "$fence" -eq 1 ] && continue
    rest=$line
    file=""
    while [[ $rest =~ ^([^\`]*)\`([^\`]+)\`(.*)$ ]]; do
      gap=${BASH_REMATCH[1]}
      span=${BASH_REMATCH[2]}
      rest=${BASH_REMATCH[3]}
      if [ -n "$file" ] && [ "$gap" = " " ] && [[ $span =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]]; then
        checked=$((checked + 1))
        grep -qF -- "$span" "$file" || broke "$f:$n \`$span\` not found in \`$file\`"
        file=""
        continue
      fi
      file=""
      if is_path "$span"; then
        checked=$((checked + 1))
        if [ ! -e "${span%/}" ]; then
          broke "$f:$n missing path \`$span\`"
        elif [ -f "$span" ]; then
          file=$span
        fi
      fi
    done
    rest=$line
    while [[ $rest =~ \]\(([^\)]+)\)(.*)$ ]]; do
      target=${BASH_REMATCH[1]%%#*}
      rest=${BASH_REMATCH[2]}
      case $target in '' | *:*) continue ;; esac
      checked=$((checked + 1))
      [ -e "$(dirname "$f")/$target" ] || broke "$f:$n missing link \`$target\`"
    done
  done <"$f"
done < <(find "$dir" -name '*.md' -print0 | sort -z)

if [ "$broken" -eq 0 ]; then
  echo "PASS $checked pointers in $dir"
  exit 0
fi
echo "FAIL $broken of $checked pointers in $dir are broken"
exit 1
